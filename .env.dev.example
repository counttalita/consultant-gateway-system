# Development Environment Configuration (Render)

# Database (Render-managed)
DATABASE_URL=

# Redis (Render-managed)
REDIS_URL=

# Rails
RAILS_ENV=development
RAILS_MASTER_KEY=

# Airtable Configuration (Test Instance)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TIMEOUT=30

# Xero Configuration (Sandbox)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_REDIRECT_URI=https://dev.uptimeconsulting.co.za/auth/xero/callback

# Harvest Configuration (Test Account)
HARVEST_ACCOUNT_ID=
HARVEST_ACCESS_TOKEN=
HARVEST_TIMEOUT=30

# ClickUp Configuration (Test Workspace)
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_TIMEOUT=30

# Google Drive Configuration (Test Folder)
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=

# Resend Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=dev@uptimeconsulting.co.za
RESEND_FROM_NAME=Up Time Consulting (Dev)

# SimplePay Configuration (Test Account)
SIMPLEPAY_API_KEY=
SIMPLEPAY_COMPANY_ID=

# Application Configuration
APP_HOST=dev.uptimeconsulting.co.za
APP_PROTOCOL=https
FRONTEND_URL=https://dev.uptimeconsulting.co.za
CORS_ORIGINS=https://dev.uptimeconsulting.co.za

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=3

# Session Configuration
SESSION_EXPIRY_HOURS=24

# Cache Configuration
CACHE_TTL_MINUTES=5
CACHE_STALE_SERVE_ENABLED=true

# Retry Configuration
MAX_RETRIES=3
BASE_RETRY_DELAY_SECONDS=1

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Notification Configuration
ADMIN_NOTIFICATION_EMAILS=admin@uptimeconsulting.co.za,dev-team@uptimeconsulting.co.za
FINANCE_NOTIFICATION_EMAILS=finance@uptimeconsulting.co.za

# Feature Flags
FEATURE_FLAGS=

# Debug Configuration
RAILS_LOG_LEVEL=debug
VERBOSE_LOGGING=true
