# Database
DATABASE_URL=postgresql://localhost/consultant_gateway_development

# Redis
REDIS_URL=redis://localhost:6379/0

# Rails
RAILS_ENV=development
RAILS_MASTER_KEY=

# Airtable Configuration
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TIMEOUT=30

# Xero Configuration
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_REDIRECT_URI=http://localhost:3000/auth/xero/callback

# Harvest Configuration
HARVEST_ACCOUNT_ID=
HARVEST_ACCESS_TOKEN=
HARVEST_TIMEOUT=30

# ClickUp Configuration
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_TIMEOUT=30

# Google Drive Configuration
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=

# Resend Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@uptimeconsulting.co.za
RESEND_FROM_NAME=Up Time Consulting

# SimplePay Configuration
SIMPLEPAY_API_KEY=
SIMPLEPAY_COMPANY_ID=

# Application Configuration
APP_HOST=localhost:3000
APP_PROTOCOL=http
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_HOUR=3

# Session Configuration
SESSION_EXPIRY_HOURS=24

# Cache Configuration
CACHE_TTL_MINUTES=5
CACHE_STALE_SERVE_ENABLED=true

# Retry Configuration
MAX_RETRIES=3
BASE_RETRY_DELAY_SECONDS=1

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Notification Configuration
ADMIN_NOTIFICATION_EMAILS=admin@uptimeconsulting.co.za
FINANCE_NOTIFICATION_EMAILS=finance@uptimeconsulting.co.za

# Feature Flags (format: feature1:true,feature2:false)
FEATURE_FLAGS=
